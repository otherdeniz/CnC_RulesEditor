@page "/features"

<PageTitle>Features - C&C Rules Editor</PageTitle>

<!-- Hero Section -->
<section class="hero">
    <div class="hero-content">
        <h2>Main Features</h2>
        <p>Discover the powerful capabilities that make C&C Rules Editor the ultimate modding tool</p>
    </div>
</section>

<!-- Main Content -->
<main>
    <!-- Entity Editing -->
    <section id="entity-editing">
        <h2>1. Entity Editing</h2>
        
        <h3>Supported Entity Types</h3>
        <div class="features-grid">
            <div class="feature-card">
                <h4>Buildings</h4>
                <ul>
                    <li>Structures and defenses</li>
                    <li>Power plants and refineries</li>
                    <li>Production facilities</li>
                    <li>Special buildings</li>
                </ul>
            </div>
            <div class="feature-card">
                <h4>Infantry</h4>
                <ul>
                    <li>Soldiers and heroes</li>
                    <li>Engineers and spies</li>
                    <li>Special units</li>
                    <li>Custom infantry types</li>
                </ul>
            </div>
            <div class="feature-card">
                <h4>Vehicles</h4>
                <ul>
                    <li>Tanks and APCs</li>
                    <li>Harvesters</li>
                    <li>Artillery units</li>
                    <li>Special vehicles</li>
                </ul>
            </div>
            <div class="feature-card">
                <h4>Aircraft</h4>
                <ul>
                    <li>Planes and helicopters</li>
                    <li>Transport aircraft</li>
                    <li>Attack aircraft</li>
                    <li>Custom air units</li>
                </ul>
            </div>
            <div class="feature-card">
                <h4>Weapons</h4>
                <ul>
                    <li>Projectiles and effects</li>
                    <li>Damage properties</li>
                    <li>Rate of fire settings</li>
                    <li>Range and accuracy</li>
                </ul>
            </div>
            <div class="feature-card">
                <h4>Warheads</h4>
                <ul>
                    <li>Damage types</li>
                    <li>Armor effectiveness</li>
                    <li>Splash damage</li>
                    <li>Special effects</li>
                </ul>
            </div>
        </div>

        <h3>Editing Capabilities</h3>
        <div class="feature-card">
            <ul>
                <li>Visual property grid with categorization</li>
                <li>Dropdown lookups for references</li>
                <li>Multi-value selection</li>
                <li>Color pickers for visual properties</li>
                <li>Favorite values marking</li>
                <li>Value comparison between entities</li>
                <li>Bulk editing via snippets</li>
                <li>Real-time validation</li>
            </ul>
        </div>
    </section>

    <!-- Visual Asset Integration -->
    <section id="visual-assets">
        <h2>2. Visual Asset Integration</h2>
        
        <div class="features-grid">
            <div class="feature-card">
                <h3>Cameo Display</h3>
                <ul>
                    <li>Automatic extraction from MIX files</li>
                    <li>Fallback to default bitmaps</li>
                    <li>Brightness adjustment</li>
                    <li>Overlay support (PNG over BMP)</li>
                    <li>Preview in entity list</li>
                    <li>Custom cameo support</li>
                </ul>
            </div>
            <div class="feature-card">
                <h3>Animation Preview</h3>
                <ul>
                    <li>SHP file playback</li>
                    <li>Frame-by-frame viewing</li>
                    <li>Palette-based rendering</li>
                    <li>Infantry sequence animations</li>
                    <li>Voxel model support</li>
                    <li>Animation speed control</li>
                </ul>
            </div>
            <div class="feature-card">
                <h3>Audio Playback</h3>
                <ul>
                    <li>Direct playback from MIX files</li>
                    <li>AUD format support</li>
                    <li>Sound.ini integration</li>
                    <li>Preview before applying</li>
                    <li>Volume control</li>
                    <li>Multiple audio formats</li>
                </ul>
            </div>
        </div>
    </section>

    <!-- Advanced Features -->
    <section id="advanced-features">
        <h2>3. Advanced Features</h2>
        
        <div class="features-grid">
            <div class="feature-card">
                <h3>Balance Analysis Tool</h3>
                <ul>
                    <li>Compare unit statistics side-by-side</li>
                    <li>Calculate cost-effectiveness ratios</li>
                    <li>Analyze damage output vs. health</li>
                    <li>Export balance reports</li>
                    <li>Visual comparison charts</li>
                    <li>Quick balancing adjustments</li>
                </ul>
            </div>
            <div class="feature-card">
                <h3>Snippet System</h3>
                <ul>
                    <li>Pre-configured unit templates</li>
                    <li>Quick insertion of common units</li>
                    <li>Customizable snippet library</li>
                    <li>Organized by category</li>
                    <li>Export custom snippets</li>
                    <li>Share snippets with community</li>
                </ul>
            </div>
            <div class="feature-card">
                <h3>MIX Browser</h3>
                <ul>
                    <li>Explore MIX file contents</li>
                    <li>Extract individual files</li>
                    <li>Preview images and sounds</li>
                    <li>Search functionality</li>
                    <li>File information display</li>
                    <li>Batch extraction</li>
                </ul>
            </div>
            <div class="feature-card">
                <h3>File Comparison</h3>
                <ul>
                    <li>Compare two rules.ini files</li>
                    <li>Highlight differences</li>
                    <li>Merge changes</li>
                    <li>Track modifications</li>
                    <li>Diff view</li>
                    <li>Conflict resolution</li>
                </ul>
            </div>
        </div>
    </section>

    <!-- Mod Support -->
    <section id="mod-support">
        <h2>4. Advanced Mod Support</h2>
        
        <div class="features-grid">
            <div class="feature-card">
                <h3>Ares Engine Extension</h3>
                <ul>
                    <li>Additional unit properties</li>
                    <li>Extended weapon types</li>
                    <li>Custom warhead effects</li>
                    <li>Loaded via DatastructureAres.json</li>
                    <li>Full Ares feature support</li>
                </ul>
            </div>
            <div class="feature-card">
                <h3>Phobos Engine Extension</h3>
                <ul>
                    <li>Advanced AI features</li>
                    <li>New unit abilities</li>
                    <li>Enhanced effects</li>
                    <li>Loaded via DatastructurePhobos.json</li>
                    <li>Latest Phobos features</li>
                </ul>
            </div>
            <div class="feature-card">
                <h3>Vinifera Engine Extension</h3>
                <ul>
                    <li>Tiberian Sun enhancements</li>
                    <li>Additional features</li>
                    <li>Loaded via DatastructureVinifera.json</li>
                    <li>TS-specific improvements</li>
                    <li>Extended functionality</li>
                </ul>
            </div>
        </div>
    </section>

    <!-- User Experience -->
    <section id="user-experience">
        <h2>5. User Experience Features</h2>
        
        <div class="features-grid">
            <div class="feature-card">
                <h3>Theme Support</h3>
                <ul>
                    <li>Light and dark themes</li>
                    <li>Customizable via Themes.json</li>
                    <li>Persistent user preference</li>
                    <li>Eye-friendly dark mode</li>
                </ul>
            </div>
            <div class="feature-card">
                <h3>Favorites System</h3>
                <ul>
                    <li>Mark frequently used units</li>
                    <li>Mark important values</li>
                    <li>Quick filter by favorites</li>
                    <li>Easy access to common items</li>
                </ul>
            </div>
            <div class="feature-card">
                <h3>Search and Filter</h3>
                <ul>
                    <li>Real-time entity search</li>
                    <li>Filter by type</li>
                    <li>Filter by parent class</li>
                    <li>Advanced filter options</li>
                </ul>
            </div>
        </div>
    </section>
</main>
